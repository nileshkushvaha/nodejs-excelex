NODE_ENV=development
PORT=3001

# The client runtime role. Must NOT be the schema owner or a superuser — both
# bypass row-level security, and the boot assertions reject them in production.
DATABASE_URL="postgresql://excelex_app:dev_app_password@localhost:5432/excelex?schema=public"
DATABASE_PLATFORM_URL="postgresql://excelex_platform:dev_platform_password@localhost:5432/excelex?schema=public"

# A request whose host does not match this suffix is refused before any handler.
APP_BASE_DOMAIN=localhost

# Believe X-Forwarded-Host only behind a proxy we control. The header is
# forgeable by any caller, and believing it is a client-takeover vector.
TRUST_PROXY_HEADERS=false

SESSION_COOKIE_NAME=__Host-excelex_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

WEB_ORIGIN=http://localhost:3000
