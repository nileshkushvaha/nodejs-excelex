NODE_ENV=development
PORT=3001

# The client runtime role. Must NOT be the schema owner or a superuser — both
# bypass row-level security, and the boot assertions reject them in production.
DATABASE_URL="postgresql://excelex_app:dev_app_password@localhost:5432/excelex?schema=public"
DATABASE_PLATFORM_URL="postgresql://excelex_platform:dev_platform_password@localhost:5432/excelex?schema=public"
DATABASE_JOBS_URL="postgresql://excelex_jobs:dev_jobs_password@localhost:5432/excelex?schema=public"

# A request whose host does not match this suffix is refused before any handler.
APP_BASE_DOMAIN=localhost

# Believe X-Forwarded-Host only behind a proxy we control. The header is
# forgeable by any caller, and believing it is a client-takeover vector.
TRUST_PROXY_HEADERS=false

SESSION_COOKIE_NAME=__Host-excelex_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

WEB_ORIGIN=http://localhost:3000

# Rate limiting (all in Redis, shared by every API instance). 0 disables a limit.
# RATE_LIMIT_PER_MINUTE=600        # per address, whole API
# LOGIN_RATE_LIMIT_PER_IP=60       # sign-in attempts per address per minute
# LOGIN_RATE_LIMIT_PER_EMAIL=10    # sign-in attempts per email per 5 minutes (client can switch off)
# TRUST_PROXY_HOPS=2               # proxies between the client and this process (nginx + web) when TRUST_PROXY_HEADERS=true
# LOG_LEVEL=log                    # fatal | error | warn | log | debug | verbose

# Error reporting. Unset = nothing is sent anywhere; the log is still complete.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production      # defaults to NODE_ENV
# SENTRY_RELEASE=<git sha>           # set by the deploy, so a report names its build
# SENTRY_TRACES_SAMPLE_RATE=0        # errors only; raise deliberately for tracing

# Outgoing mail. Development points at Mailpit (docker compose; inbox at http://localhost:8025).
# SMTP_URL=smtp://localhost:1025          # smtps://user:pass@host:465 in production; "json" renders without sending
# MAIL_FROM_NAME=ExcelEx
# MAIL_FROM_EMAIL=no-reply@excelex.local
# SECRETS_KEY=                             # REQUIRED in production: openssl rand -base64 32 (encrypts client SMTP passwords)

# Media storage (ADR-0006). "local" writes under STORAGE_ROOT and the API serves
# the files; production should use "s3" (any S3-compatible store).
# STORAGE_DRIVER=local
# STORAGE_ROOT=./storage
# UPLOAD_MAX_MB=25
# STORAGE_S3_BUCKET= / STORAGE_S3_REGION= / STORAGE_S3_ENDPOINT= / STORAGE_S3_ACCESS_KEY= / STORAGE_S3_SECRET_KEY=
