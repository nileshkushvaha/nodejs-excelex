{
  "name": "excelex-platform",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:seed": "pnpm --filter @excelex/database run db:seed",
    "db:verify": "pnpm --filter @excelex/database run db:verify",
    "test:security": "turbo run test:security",
    "test:unit": "turbo run test:unit",
    "test": "turbo run test:unit test:security"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5",
    "prettier": "^3"
  },
  "packageManager": "pnpm@11.22.0"
}
