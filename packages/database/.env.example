# Four roles, four connection strings. The separation is the point: the runtime
# never holds migration privileges, and a table owner is exempt from row-level
# security unless FORCE is applied — so the application must not be the owner.
#
# Copy to .env for local development. .env is gitignored and must stay that way;
# staging and production read these from the platform secret store, injected at
# container start, never from a file in the image.

# Schema owner. Used ONLY by Prisma Migrate and the security script.
DATABASE_MIGRATION_URL="postgresql://excelex_owner:dev_owner_password@localhost:5432/excelex?schema=public"

# Client runtime. RLS applies. No privileges at all on platform tables.
DATABASE_URL="postgresql://excelex_app:dev_app_password@localhost:5432/excelex?schema=public"

# Platform runtime. Control-plane tables; reaches client data only through audited support access.
DATABASE_PLATFORM_URL="postgresql://excelex_platform:dev_platform_password@localhost:5432/excelex?schema=public"

# Background workers. Narrow, enumerable cross-client reads on named tables only — never BYPASSRLS.
DATABASE_JOBS_URL="postgresql://excelex_jobs:dev_jobs_password@localhost:5432/excelex?schema=public"
