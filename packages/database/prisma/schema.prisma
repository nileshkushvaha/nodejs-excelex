// ExcelEx Platform — Phase 1 schema
// Scope classification is DECLARED, never inferred from the presence of a clientId
// column (audit finding CT-1). Every model carries exactly one scope annotation.
//
//   @scope(platform) — control plane. REVOKED from excelex_app. No RLS.
//   @scope(client)   — client data. RLS enforced. excelex_app may read/write.
//
// tools/generate-rls.ts reads these annotations to emit policies and grants.
// A model with no annotation is a build failure.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// PLATFORM SCOPE — control plane
// ─────────────────────────────────────────────────────────────

/// @scope(platform)
model Client {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  legalName String       @map("legal_name")
  status    ClientStatus @default(TRIAL)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  hostnames     ClientHostname[]
  subscriptions Subscription[]
  branches      Branch[]
  users         User[]
  roles         Role[]
  sessions      Session[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]

  @@map("clients")
}

enum ClientStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CLOSED
}

/// @scope(platform)
/// Routing authority. The reserved-name constraint lives HERE, not on
/// clients.slug — slugs do not route anything (audit finding HH-2).
model ClientHostname {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  hostname   String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("client_hostnames")
}

/// @scope(platform)
model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  limits        PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

/// @scope(platform)
model PlanLimit {
  id          String          @id @default(uuid(7)) @db.Uuid
  planId      String          @map("plan_id") @db.Uuid
  limitKey    String          @map("limit_key")
  limitValue  BigInt          @map("limit_value")
  enforcement EnforcementMode @default(HARD)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, limitKey])
  @@map("plan_limits")
}

enum EnforcementMode {
  HARD
  SOFT
  METERED
}

/// @scope(platform)
model Subscription {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  trialEnds DateTime? @map("trial_ends") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("subscriptions")
}

/// @scope(platform)
/// ExcelEx staff. Separate from client users entirely — different table,
/// different session store, mandatory MFA.
model PlatformUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  permissions  String[]  @default([])
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions        PlatformSession[]
  mfa             PlatformUserMfa?
  supportSessions SupportAccessSession[]

  @@map("platform_users")
}

/// @scope(platform)
model PlatformSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  platformUserId String    @map("platform_user_id") @db.Uuid
  host           String
  ip             String?
  userAgent      String?   @map("user_agent")
  mfaSatisfiedAt DateTime? @map("mfa_satisfied_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiry DateTime  @map("absolute_expiry") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_sessions")
}

/// @scope(platform)
model PlatformUserMfa {
  id             String    @id @default(uuid(7)) @db.Uuid
  platformUserId String    @unique @map("platform_user_id") @db.Uuid
  secret         String
  recoveryHashes String[]  @default([]) @map("recovery_hashes")
  enrolledAt     DateTime? @map("enrolled_at") @db.Timestamptz(6)
  lastUsedStep   BigInt?   @map("last_used_step")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("platform_user_mfa")
}

/// @scope(platform)
/// Append-only. UPDATE and DELETE are revoked from every runtime role.
/// Honest claim: this is immutable to the application, NOT to the database
/// owner. Tamper-evidence is deferred (see AUDIT-3 §4).
model PlatformAuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  reason    String?
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@map("platform_audit_events")
}

/// @scope(platform)
/// Read-only by default, explicit reason, short expiry, step-up MFA required,
/// client notified. Write access needs a second approver.
model SupportAccessSession {
  id             String      @id @default(uuid(7)) @db.Uuid
  platformUserId String      @map("platform_user_id") @db.Uuid
  clientId       String      @map("client_id") @db.Uuid
  reason         String
  mode           SupportMode @default(READ_ONLY)
  approvedById   String?     @map("approved_by_id") @db.Uuid
  notifiedAt     DateTime?   @map("notified_at") @db.Timestamptz(6)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([clientId, expiresAt])
  @@map("support_access_sessions")
}

enum SupportMode {
  READ_ONLY
  READ_WRITE
}

// ─────────────────────────────────────────────────────────────
// CLIENT SCOPE — RLS enforced, clientId mandatory
// ─────────────────────────────────────────────────────────────

/// @scope(client)
model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  memberships UserBranchMembership[]
  userRoles   UserRole[]

  // Unconditional composite unique — required as a composite FK target.
  // Partial unique indexes cannot back a foreign key (audit finding B4).
  @@unique([clientId, id], name: "branch_client_id")
  /// Uniqueness of code is a PARTIAL unique index (deleted_at IS NULL), created
  /// in the migration — Prisma cannot express one. Without that, a soft-deleted
  /// branch squats its own code forever.
  @@index([clientId, code])
  @@index([clientId])
  @@map("branches")
}

/// @scope(client)
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  email             String
  fullName          String    @map("full_name")
  passwordHash      String?   @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Recorded now so password expiry can be enforced later without a backfill
  /// that would have to guess when everyone last changed theirs.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)

  /// Consecutive failures since the last success. Reset on any successful
  /// sign-in, so a locked-out account is one that failed repeatedly in a row
  /// rather than one that has simply been used for a long time.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  /// Null means not locked. A far-future value is how "until an administrator
  /// unlocks it" is represented, so one column answers the whole question.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  memberships     UserBranchMembership[]
  userRoles       UserRole[]
  userPermissions UserPermission[]
  sessions        Session[]
  passwordHistory PasswordHistory[]

  @@unique([clientId, id], name: "user_client_id")
  /// Partial unique index on (client_id, email) WHERE deleted_at IS NULL — see
  /// the migration. A soft-deleted user must not hold their address forever.
  @@index([clientId, email])
  @@index([clientId])
  @@map("users")
}

/// @scope(client)
model UserBranchMembership {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  // Composite FKs — a cross-client reference is structurally impossible.
  // MATCH SIMPLE (the default) is correct here; MATCH FULL would make
  // optional relations unrepresentable (audit finding A2).
  user   User   @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)
  branch Branch @relation(fields: [clientId, branchId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, branchId])
  @@index([clientId])
  @@map("user_branch_memberships")
}

/// @scope(client)
/// Permissions are a typed vocabulary in packages/permissions, stored as
/// strings. No separate Permission table — the catalogue lives in code so a
/// typo is a compile error rather than a silent authorisation gap.
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([clientId, id], name: "role_client_id")
  /// Partial unique index on (client_id, name) WHERE deleted_at IS NULL.
  @@index([clientId, name])
  @@index([clientId])
  @@map("roles")
}

/// @scope(client)
/// A role assignment. branchId null means the role applies across the whole
/// client; a branch-scoped row limits it to that branch — Spatie's "teams",
/// but native, because a branch manager in Delhi is not one in Mumbai.
/// Assign several rows to cover several branches.
model UserRole {
  id          String    @id @default(uuid(7)) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  /// Temporary cover that expires on its own rather than becoming permanent.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  grantedById String?   @map("granted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)
  role   Role    @relation(fields: [clientId, roleId], references: [clientId, id], onDelete: Cascade)
  branch Branch? @relation(fields: [clientId, branchId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, roleId, branchId])
  @@index([clientId, userId])
  @@map("user_roles")
}

/// @scope(client)
/// What a role grants. A join table rather than a string array, so a permission
/// can be added or removed without rewriting the row, and so "which roles grant
/// this?" is a query rather than a scan.
model RolePermission {
  id            String   @id @default(uuid(7)) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [clientId, roleId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, roleId, permissionKey])
  @@index([clientId])
  @@map("role_permissions")
}

/// @scope(client)
/// A permission granted or denied to one person, outside any role.
///
/// The DENY effect is the piece Spatie has no equivalent for. It makes "the
/// operations manager role, except this one person may not reopen manifests"
/// expressible without inventing a near-duplicate role — and near-duplicate
/// roles are how permission models rot.
model UserPermission {
  id            String           @id @default(uuid(7)) @db.Uuid
  clientId      String           @map("client_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  permissionKey String           @map("permission_key")
  effect        PermissionEffect @default(ALLOW)
  /// Required for DENY in the service layer: a denial nobody can explain later
  /// is one nobody dares remove.
  reason        String?
  expiresAt     DateTime?        @map("expires_at") @db.Timestamptz(6)
  grantedById   String?          @map("granted_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, permissionKey])
  @@index([clientId, userId])
  @@map("user_permissions")
}

enum PermissionEffect {
  ALLOW
  DENY
}

/// @scope(client)
/// Opaque server-side sessions. Only the SHA-256 hash of the token is stored,
/// so a database read does not yield a usable session.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  host           String
  ip             String?
  userAgent      String?   @map("user_agent")
  idleExpiresAt  DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiry DateTime  @map("absolute_expiry") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@index([clientId, userId])
  @@map("sessions")
}

/// @scope(client)
/// Single-use activation tokens, stored hashed. Legacy password hashes are
/// never imported — migrated users receive one of these instead.
model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  roleIds    String[]  @default([]) @map("role_ids")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, email])
  @@map("invitations")
}

/// @scope(client)
/// Append-only client audit trail.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("audit_events")
}

/// @scope(platform)
/// The permission catalogue, synced from @excelex/permissions.
///
/// The code is the source of truth and this table is its projection — the
/// opposite of a database-first model like Spatie's. That is what lets a guard
/// naming a permission fail to compile rather than fail silently at runtime.
///
/// It is platform-scoped because the vocabulary is the same for every client;
/// a client cannot invent a permission the code does not implement. Grant rows
/// deliberately carry no foreign key to it, because a grant may be a wildcard
/// (`operations.*`) which by definition has no catalogue row. Existence is
/// validated in the service layer against the typed catalogue, and the stored
/// shape is constrained in the migration.
model Permission {
  key         String   @id
  group       String
  label       String
  description String
  deprecated  Boolean  @default(false)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("permissions")
}

/// @scope(client)
/// One row per client. The password policy is a client's own security decision —
/// many inherit composition rules from a customer's or insurer's questionnaire
/// and cannot decline them, so the rules are configurable rather than a constant
/// compiled into the code.
model PasswordPolicy {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  minLength        Int     @default(8) @map("min_length")
  requireUppercase Boolean @default(false) @map("require_uppercase")
  requireLowercase Boolean @default(false) @map("require_lowercase")
  requireNumber    Boolean @default(false) @map("require_number")
  requireSpecial   Boolean @default(false) @map("require_special")

  preventReuse Boolean @default(true) @map("prevent_reuse")
  historyCount Int     @default(5) @map("history_count")

  /// Stored and editable, not yet enforced — enforcement needs the forced-change
  /// flow that arrives with invitations. Labelled as such in the UI rather than
  /// presented as working.
  expiryEnabled           Boolean @default(false) @map("expiry_enabled")
  expiryDays              Int     @default(90) @map("expiry_days")
  forceChangeOnFirstLogin Boolean @default(false) @map("force_change_on_first_login")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_policies")
}

/// @scope(client)
/// Previous password hashes, so reuse can be refused.
///
/// Only hashes are kept, and they are pruned to the policy's history count on
/// every change — an unbounded list of a person's old credentials is a liability
/// that grows for as long as they work here.
model PasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@index([clientId, userId, createdAt])
  @@map("password_history")
}

/// @scope(client)
/// Login and session security. One row per client, alongside the password
/// policy — same shape, same reasoning: these are a client's own security
/// decisions, often inherited from a customer's security questionnaire.
///
/// Fields are marked below as enforced or stored-only. A toggle that looks like
/// it works and does not is worse than an absent one, so the UI says which is
/// which rather than implying everything is live.
model SecuritySettings {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // ── Login attempts — ENFORCED ────────────────────────────────────────────
  lockAfterFailedAttempts Boolean @default(true) @map("lock_after_failed_attempts")
  maxFailedAttempts       Int     @default(5) @map("max_failed_attempts")
  /// Minutes an account stays locked. 0 means until an administrator unlocks it.
  lockoutMinutes          Int     @default(15) @map("lockout_minutes")

  // ── Sessions — ENFORCED ──────────────────────────────────────────────────
  idleTimeoutMinutes          Int     @default(60) @map("idle_timeout_minutes")
  absoluteTimeoutHours        Int     @default(12) @map("absolute_timeout_hours")
  /// When false, signing in on a new device ends every other session.
  allowMultipleSessions       Boolean @default(true) @map("allow_multiple_sessions")
  forceLogoutOnPasswordChange Boolean @default(true) @map("force_logout_on_password_change")

  // ── Stored, NOT yet enforced ─────────────────────────────────────────────
  /// Needs Redis, which is in the compose stack but not yet wired.
  loginThrottleEnabled       Boolean @default(true) @map("login_throttle_enabled")
  resetThrottleEnabled       Boolean @default(true) @map("reset_throttle_enabled")
  /// Need a mail transport; Mailpit is not yet wired.
  notifyUserOnFailedAttempts Boolean @default(false) @map("notify_user_on_failed_attempts")
  notifyUserOnLock           Boolean @default(true) @map("notify_user_on_lock")
  notifyAdminOnLock          Boolean @default(false) @map("notify_admin_on_lock")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("security_settings")
}
