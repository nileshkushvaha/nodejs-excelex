// ExcelEx Platform — Phase 1 schema
// Scope classification is DECLARED, never inferred from the presence of a clientId
// column (audit finding CT-1). Every model carries exactly one scope annotation.
//
//   @scope(platform) — control plane. REVOKED from excelex_app. No RLS.
//   @scope(client)   — client data. RLS enforced. excelex_app may read/write.
//
// tools/generate-rls.ts reads these annotations to emit policies and grants.
// A model with no annotation is a build failure.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// PLATFORM SCOPE — control plane
// ─────────────────────────────────────────────────────────────

/// @scope(platform)
model Client {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique
  legalName String       @map("legal_name")
  status    ClientStatus @default(TRIAL)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  hostnames     ClientHostname[]
  subscriptions Subscription[]
  branches      Branch[]
  users         User[]
  roles         Role[]
  sessions      Session[]
  invitations   Invitation[]
  auditEvents   AuditEvent[]

  @@map("clients")
}

enum ClientStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CLOSED
}

/// @scope(platform)
/// Routing authority. The reserved-name constraint lives HERE, not on
/// clients.slug — slugs do not route anything (audit finding HH-2).
model ClientHostname {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  hostname   String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  retiredAt  DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("client_hostnames")
}

/// @scope(platform)
model Plan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  limits        PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

/// @scope(platform)
model PlanLimit {
  id          String          @id @default(uuid(7)) @db.Uuid
  planId      String          @map("plan_id") @db.Uuid
  limitKey    String          @map("limit_key")
  limitValue  BigInt          @map("limit_value")
  enforcement EnforcementMode @default(HARD)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, limitKey])
  @@map("plan_limits")
}

enum EnforcementMode {
  HARD
  SOFT
  METERED
}

/// @scope(platform)
model Subscription {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startsAt  DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  trialEnds DateTime? @map("trial_ends") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("subscriptions")
}

/// @scope(platform)
/// ExcelEx staff. Separate from client users entirely — different table,
/// different session store, mandatory MFA.
model PlatformUser {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  permissions  String[]  @default([])
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions        PlatformSession[]
  mfa             PlatformUserMfa?
  supportSessions SupportAccessSession[]

  @@map("platform_users")
}

/// @scope(platform)
model PlatformSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  platformUserId String    @map("platform_user_id") @db.Uuid
  host           String
  ip             String?
  userAgent      String?   @map("user_agent")
  mfaSatisfiedAt DateTime? @map("mfa_satisfied_at") @db.Timestamptz(6)
  idleExpiresAt  DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiry DateTime  @map("absolute_expiry") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
  @@map("platform_sessions")
}

/// @scope(platform)
model PlatformUserMfa {
  id             String    @id @default(uuid(7)) @db.Uuid
  platformUserId String    @unique @map("platform_user_id") @db.Uuid
  secret         String
  recoveryHashes String[]  @default([]) @map("recovery_hashes")
  enrolledAt     DateTime? @map("enrolled_at") @db.Timestamptz(6)
  lastUsedStep   BigInt?   @map("last_used_step")

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("platform_user_mfa")
}

/// @scope(platform)
/// Append-only. UPDATE and DELETE are revoked from every runtime role.
/// Honest claim: this is immutable to the application, NOT to the database
/// owner. Tamper-evidence is deferred (see AUDIT-3 §4).
model PlatformAuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  reason    String?
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@map("platform_audit_events")
}

/// @scope(platform)
/// Read-only by default, explicit reason, short expiry, step-up MFA required,
/// client notified. Write access needs a second approver.
model SupportAccessSession {
  id             String      @id @default(uuid(7)) @db.Uuid
  platformUserId String      @map("platform_user_id") @db.Uuid
  clientId       String      @map("client_id") @db.Uuid
  reason         String
  mode           SupportMode @default(READ_ONLY)
  approvedById   String?     @map("approved_by_id") @db.Uuid
  notifiedAt     DateTime?   @map("notified_at") @db.Timestamptz(6)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([clientId, expiresAt])
  @@map("support_access_sessions")
}

enum SupportMode {
  READ_ONLY
  READ_WRITE
}

// ─────────────────────────────────────────────────────────────
// CLIENT SCOPE — RLS enforced, clientId mandatory
// ─────────────────────────────────────────────────────────────

/// @scope(client)
model Branch {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  memberships UserBranchMembership[]
  userRoles   UserRole[]

  // Unconditional composite unique — required as a composite FK target.
  // Partial unique indexes cannot back a foreign key (audit finding B4).
  @@unique([clientId, id], name: "branch_client_id")
  /// Uniqueness of code is a PARTIAL unique index (deleted_at IS NULL), created
  /// in the migration — Prisma cannot express one. Without that, a soft-deleted
  /// branch squats its own code forever.
  @@index([clientId, code])
  @@index([clientId])
  @@map("branches")
}

/// @scope(client)
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  email             String
  fullName          String    @map("full_name")
  passwordHash      String?   @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// Recorded now so password expiry can be enforced later without a backfill
  /// that would have to guess when everyone last changed theirs.
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)

  /// Consecutive failures since the last success. Reset on any successful
  /// sign-in, so a locked-out account is one that failed repeatedly in a row
  /// rather than one that has simply been used for a long time.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(6)
  /// Null means not locked. A far-future value is how "until an administrator
  /// unlocks it" is represented, so one column answers the whole question.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  memberships     UserBranchMembership[]
  userRoles       UserRole[]
  userPermissions UserPermission[]
  sessions        Session[]
  passwordHistory PasswordHistory[]

  @@unique([clientId, id], name: "user_client_id")
  /// Partial unique index on (client_id, email) WHERE deleted_at IS NULL — see
  /// the migration. A soft-deleted user must not hold their address forever.
  @@index([clientId, email])
  @@index([clientId])
  @@map("users")
}

/// @scope(client)
model UserBranchMembership {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  // Composite FKs — a cross-client reference is structurally impossible.
  // MATCH SIMPLE (the default) is correct here; MATCH FULL would make
  // optional relations unrepresentable (audit finding A2).
  user   User   @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)
  branch Branch @relation(fields: [clientId, branchId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, branchId])
  @@index([clientId])
  @@map("user_branch_memberships")
}

/// @scope(client)
/// Permissions are a typed vocabulary in packages/permissions, stored as
/// strings. No separate Permission table — the catalogue lives in code so a
/// typo is a compile error rather than a silent authorisation gap.
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([clientId, id], name: "role_client_id")
  /// Partial unique index on (client_id, name) WHERE deleted_at IS NULL.
  @@index([clientId, name])
  @@index([clientId])
  @@map("roles")
}

/// @scope(client)
/// A role assignment. branchId null means the role applies across the whole
/// client; a branch-scoped row limits it to that branch — Spatie's "teams",
/// but native, because a branch manager in Delhi is not one in Mumbai.
/// Assign several rows to cover several branches.
model UserRole {
  id          String    @id @default(uuid(7)) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  /// Temporary cover that expires on its own rather than becoming permanent.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  grantedById String?   @map("granted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)
  role   Role    @relation(fields: [clientId, roleId], references: [clientId, id], onDelete: Cascade)
  branch Branch? @relation(fields: [clientId, branchId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, roleId, branchId])
  @@index([clientId, userId])
  @@map("user_roles")
}

/// @scope(client)
/// What a role grants. A join table rather than a string array, so a permission
/// can be added or removed without rewriting the row, and so "which roles grant
/// this?" is a query rather than a scan.
model RolePermission {
  id            String   @id @default(uuid(7)) @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role Role @relation(fields: [clientId, roleId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, roleId, permissionKey])
  @@index([clientId])
  @@map("role_permissions")
}

/// @scope(client)
/// A permission granted or denied to one person, outside any role.
///
/// The DENY effect is the piece Spatie has no equivalent for. It makes "the
/// operations manager role, except this one person may not reopen manifests"
/// expressible without inventing a near-duplicate role — and near-duplicate
/// roles are how permission models rot.
model UserPermission {
  id            String           @id @default(uuid(7)) @db.Uuid
  clientId      String           @map("client_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  permissionKey String           @map("permission_key")
  effect        PermissionEffect @default(ALLOW)
  /// Required for DENY in the service layer: a denial nobody can explain later
  /// is one nobody dares remove.
  reason        String?
  expiresAt     DateTime?        @map("expires_at") @db.Timestamptz(6)
  grantedById   String?          @map("granted_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@unique([clientId, userId, permissionKey])
  @@index([clientId, userId])
  @@map("user_permissions")
}

enum PermissionEffect {
  ALLOW
  DENY
}

/// @scope(client)
/// Opaque server-side sessions. Only the SHA-256 hash of the token is stored,
/// so a database read does not yield a usable session.
model Session {
  id             String    @id @default(uuid(7)) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  host           String
  ip             String?
  userAgent      String?   @map("user_agent")
  idleExpiresAt  DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiry DateTime  @map("absolute_expiry") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@index([clientId, userId])
  @@map("sessions")
}

/// @scope(client)
/// Single-use activation tokens, stored hashed. Legacy password hashes are
/// never imported — migrated users receive one of these instead.
model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  roleIds    String[]  @default([]) @map("role_ids")
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, email])
  @@map("invitations")
}

/// @scope(client)
/// Append-only client audit trail.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("audit_events")
}

/// @scope(platform)
/// The permission catalogue, synced from @excelex/permissions.
///
/// The code is the source of truth and this table is its projection — the
/// opposite of a database-first model like Spatie's. That is what lets a guard
/// naming a permission fail to compile rather than fail silently at runtime.
///
/// It is platform-scoped because the vocabulary is the same for every client;
/// a client cannot invent a permission the code does not implement. Grant rows
/// deliberately carry no foreign key to it, because a grant may be a wildcard
/// (`operations.*`) which by definition has no catalogue row. Existence is
/// validated in the service layer against the typed catalogue, and the stored
/// shape is constrained in the migration.
model Permission {
  key         String   @id
  group       String
  label       String
  description String
  deprecated  Boolean  @default(false)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("permissions")
}

/// @scope(client)
/// One row per client. The password policy is a client's own security decision —
/// many inherit composition rules from a customer's or insurer's questionnaire
/// and cannot decline them, so the rules are configurable rather than a constant
/// compiled into the code.
model PasswordPolicy {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  minLength        Int     @default(8) @map("min_length")
  requireUppercase Boolean @default(false) @map("require_uppercase")
  requireLowercase Boolean @default(false) @map("require_lowercase")
  requireNumber    Boolean @default(false) @map("require_number")
  requireSpecial   Boolean @default(false) @map("require_special")

  preventReuse Boolean @default(true) @map("prevent_reuse")
  historyCount Int     @default(5) @map("history_count")

  /// Stored and editable, not yet enforced — enforcement needs the forced-change
  /// flow that arrives with invitations. Labelled as such in the UI rather than
  /// presented as working.
  expiryEnabled           Boolean @default(false) @map("expiry_enabled")
  expiryDays              Int     @default(90) @map("expiry_days")
  forceChangeOnFirstLogin Boolean @default(false) @map("force_change_on_first_login")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_policies")
}

/// @scope(client)
/// Previous password hashes, so reuse can be refused.
///
/// Only hashes are kept, and they are pruned to the policy's history count on
/// every change — an unbounded list of a person's old credentials is a liability
/// that grows for as long as they work here.
model PasswordHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [clientId, userId], references: [clientId, id], onDelete: Cascade)

  @@index([clientId, userId, createdAt])
  @@map("password_history")
}

/// @scope(client)
/// Login and session security. One row per client, alongside the password
/// policy — same shape, same reasoning: these are a client's own security
/// decisions, often inherited from a customer's security questionnaire.
///
/// Fields are marked below as enforced or stored-only. A toggle that looks like
/// it works and does not is worse than an absent one, so the UI says which is
/// which rather than implying everything is live.
model SecuritySettings {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // ── Login attempts — ENFORCED ────────────────────────────────────────────
  lockAfterFailedAttempts Boolean @default(true) @map("lock_after_failed_attempts")
  maxFailedAttempts       Int     @default(5) @map("max_failed_attempts")
  /// Minutes an account stays locked. 0 means until an administrator unlocks it.
  lockoutMinutes          Int     @default(15) @map("lockout_minutes")

  // ── Sessions — ENFORCED ──────────────────────────────────────────────────
  idleTimeoutMinutes          Int     @default(60) @map("idle_timeout_minutes")
  absoluteTimeoutHours        Int     @default(12) @map("absolute_timeout_hours")
  /// When false, signing in on a new device ends every other session.
  allowMultipleSessions       Boolean @default(true) @map("allow_multiple_sessions")
  forceLogoutOnPasswordChange Boolean @default(true) @map("force_logout_on_password_change")

  // ── Stored, NOT yet enforced ─────────────────────────────────────────────
  /// Needs Redis, which is in the compose stack but not yet wired.
  loginThrottleEnabled       Boolean @default(true) @map("login_throttle_enabled")
  resetThrottleEnabled       Boolean @default(true) @map("reset_throttle_enabled")
  /// Need a mail transport; Mailpit is not yet wired.
  notifyUserOnFailedAttempts Boolean @default(false) @map("notify_user_on_failed_attempts")
  notifyUserOnLock           Boolean @default(true) @map("notify_user_on_lock")
  notifyAdminOnLock          Boolean @default(false) @map("notify_admin_on_lock")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("security_settings")
}

// ─────────────────────────────────────────────────────────────
// REFERENCE DATA — platform scope, shared by every client
// ─────────────────────────────────────────────────────────────

/// @scope(platform)
/// ISO 3166-1 countries.
///
/// Platform-scoped because the world is the same for every client: a client
/// that could edit its own copy of India would produce shipment addresses that
/// no other client's data could be reconciled against. Read through a narrow
/// accessor, exactly like the permission catalogue.
model Country {
  /// ISO 3166-1 alpha-2. The natural key, and what carrier APIs speak.
  code         String  @id
  alpha3       String  @unique
  numeric      String  @unique
  name         String
  officialName String? @map("official_name")
  /// E.164 calling code without the plus, e.g. "91". Not unique — NANP shares 1.
  dialCode     String? @map("dial_code")
  currency     String?
  region       String?
  subregion    String?
  /// Whether ExcelEx clients may currently ship there. Serviceability per client
  /// is a separate, client-scoped concern that arrives with the rate modules.
  isActive     Boolean @default(true) @map("is_active")

  states State[]

  @@index([name])
  @@map("countries")
}

/// @scope(platform)
/// First-level administrative subdivisions. Seeded for India; other countries
/// are added as clients need them, which is why the table is keyed generically
/// rather than assuming Indian states.
model State {
  id          String  @id @default(uuid(7)) @db.Uuid
  countryCode String  @map("country_code")
  /// ISO 3166-2 subdivision part, e.g. "MH" for Maharashtra.
  code        String
  name        String
  /// India distinguishes states from union territories, and the distinction is
  /// not cosmetic — it changes which tax registration applies.
  type        String  @default("STATE")
  /// GST state code. Two digits, and the first two of every GSTIN issued there.
  gstCode     String? @map("gst_code")
  isActive    Boolean @default(true) @map("is_active")

  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@unique([countryCode, code])
  @@index([countryCode, name])
  @@map("states")
}

// ─────────────────────────────────────────────────────────────
// ORGANISATION MASTERS — client scope
// ─────────────────────────────────────────────────────────────

/// @scope(client)
/// A department within a courier company. Client-scoped because org structure is
/// a client's own decision — one runs a single Operations department, another
/// splits Hub from Last Mile.
model Department {
  id          String    @id @default(uuid(7)) @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Partial unique indexes on (client_id, code) and (client_id, name) live in
  /// the migration — a soft-deleted department must not squat its own code.
  designations Designation[]

  @@unique([clientId, id], name: "department_client_id")
  @@index([clientId, code])
  @@index([clientId])
  @@map("departments")
}

/// @scope(client)
/// A job title. Optionally belongs to a department, because a courier company
/// has titles that sit outside one — a Managing Director belongs to no
/// department, and forcing a "General" bucket to satisfy a NOT NULL is how
/// reference data starts lying.
model Designation {
  id           String    @id @default(uuid(7)) @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  code         String
  name         String
  description  String?
  /// Seniority, low to high. Used for ordering and later for approval chains.
  level        Int       @default(0)
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department? @relation(fields: [clientId, departmentId], references: [clientId, id], onDelete: Restrict)

  @@index([clientId, code])
  @@index([clientId, departmentId])
  @@index([clientId])
  @@map("designations")
}

/// @scope(client)
/// A client's own identity, contact details, statutory registrations and
/// document defaults. One row per client.
///
/// Separate from the `clients` table on purpose: that row is platform-owned —
/// ExcelEx sets the slug, status and plan — while everything here is the
/// client's own to edit. Mixing them would mean one table with two owners and
/// two very different authorisation rules.
model ClientSettings {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // ── Identity ─────────────────────────────────────────────────────────────
  legalName   String  @map("legal_name")
  tradingName String? @map("trading_name")
  /// 15 characters: two-digit state code, PAN, entity number, Z, checksum.
  gstin       String?
  /// Permanent Account Number, ten characters.
  pan         String?
  /// Corporate Identity Number, twenty-one characters.
  cin         String?

  // ── Contact ──────────────────────────────────────────────────────────────
  supportEmail String? @map("support_email")
  supportPhone String? @map("support_phone")
  websiteUrl   String? @map("website_url")

  // ── Registered address ───────────────────────────────────────────────────
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  /// ISO 3166-2 subdivision code, resolved against the states master.
  stateCode    String? @map("state_code")
  countryCode  String  @default("IN") @map("country_code")
  postalCode   String? @map("postal_code")

  // ── Localisation ─────────────────────────────────────────────────────────
  /// IANA zone. Presentation only — everything is stored in UTC.
  timezone   String @default("Asia/Kolkata")
  currency   String @default("INR")
  dateFormat String @default("dd/MM/yyyy") @map("date_format")
  /// 1 = Monday, 7 = Sunday, per ISO 8601.
  weekStart  Int    @default(1) @map("week_start")

  // ── Documents ────────────────────────────────────────────────────────────
  invoicePrefix String? @map("invoice_prefix")
  invoiceFooter String? @map("invoice_footer")
  termsText     String? @map("terms_text")

  // ── Branding ─────────────────────────────────────────────────────────────
  /// Object-storage keys, not URLs. Nothing writes these yet: uploads need the
  /// storage service, which is not wired. The columns exist so the screen can
  /// say so rather than offering a file input that silently does nothing.
  logoKey     String? @map("logo_key")
  logoDarkKey String? @map("logo_dark_key")
  faviconKey  String? @map("favicon_key")

  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("client_settings")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT MASTERS — client scope
// ─────────────────────────────────────────────────────────────

/// @scope(client)
/// What kind of movement a product is: Domestic, International, Local, Import.
///
/// Named ProductType because that is what the business calls it, but note the
/// legacy application uses "Product Type" for two different things — this, and
/// the Air/Surface/Train grouping below. They are separate masters here, since
/// one describes where a shipment goes and the other how it travels.
model ProductType {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@unique([clientId, id], name: "product_type_client_id")
  @@index([clientId])
  @@map("product_types")
}

/// @scope(client)
/// How a product travels: Air, Surface, Train, All. The legacy "Group Type".
model ProductGroup {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@unique([clientId, id], name: "product_group_client_id")
  @@index([clientId])
  @@map("product_groups")
}

/// Document or non-document.
///
/// A per-product property, not derived from the type: the legacy data has DOX
/// (International Document) and SPX (International Non Document) as two
/// products of the same type, so the distinction cannot live on the type.
/// It drives rating, packaging rules and customs paperwork.
enum ShipmentContentKind {
  DOX
  NDOX
}

/// @scope(client)
/// A sellable service — the thing an AWB is booked against.
model Product {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  code String
  name String

  productTypeId  String? @map("product_type_id") @db.Uuid
  productGroupId String? @map("product_group_id") @db.Uuid

  /// Free text in the legacy system, holding values like "SELF". Kept as text
  /// rather than promoted to a master until the vocabulary is known — inventing
  /// a master from one observed value is how reference data acquires rows
  /// nobody can explain.
  service String?

  contentKind ShipmentContentKind @default(NDOX) @map("content_kind")

  /// Whether the fuel surcharge applies. Some reverse and port-to-port products
  /// are quoted all-inclusive and must not attract it.
  fuelCharge Boolean @default(true) @map("fuel_charge")
  /// Reverse charge: the recipient accounts for GST rather than the supplier.
  gstReverse Boolean @default(false) @map("gst_reverse")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  productType  ProductType?  @relation(fields: [clientId, productTypeId], references: [clientId, id], onDelete: Restrict)
  productGroup ProductGroup? @relation(fields: [clientId, productGroupId], references: [clientId, id], onDelete: Restrict)

  @@index([clientId, code])
  @@index([clientId])
  @@map("products")
}

/// @scope(client)
/// A rating zone. Destinations are grouped into zones, and a rate card prices
/// origin-zone to destination-zone pairs rather than every city pair — which is
/// what keeps a rate card a few dozen rows instead of a few million.
model Zone {
  id           String        @id @default(uuid(7)) @db.Uuid
  clientId     String        @map("client_id") @db.Uuid
  code         String
  name         String
  isActive     Boolean       @default(true) @map("is_active")
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  destinations Destination[]

  @@unique([clientId, id], name: "zone_client_id")
  @@index([clientId, code])
  @@index([clientId])
  @@map("zones")
}

/// Where a destination sits relative to the client's home country.
enum DestinationKind {
  DOMESTIC
  INTERNATIONAL
}

/// How a destination is served. Drives rating and delivery expectations:
/// metro is priced and promised differently from remote, and remote usually
/// carries a surcharge.
enum ServiceType {
  REGULAR
  METRO
  REMOTE
}

/// @scope(client)
/// A place shipments are booked to — the servicing point behind a set of
/// pincodes, and what a rate card ultimately resolves to through its zone.
///
/// This is the first master with real volume: a live client carries well over a
/// thousand. Everything about it is therefore paged and filtered in the database
/// rather than in the browser.
model Destination {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  kind DestinationKind @default(DOMESTIC)
  code String
  name String

  email  String?
  mobile String?

  countryCode String  @default("IN") @map("country_code")
  /// ISO 3166-2 subdivision, validated against the states master for the country.
  stateCode   String? @map("state_code")

  zoneId      String?     @map("zone_id") @db.Uuid
  serviceType ServiceType @default(REGULAR) @map("service_type")

  /// Both point at other destinations: the servicing branch this place reports
  /// to, and the branch its manifests are cut against. Self-referencing rather
  /// than a separate branch table because in this business a servicing branch
  /// *is* a destination — one that happens to have others hanging off it.
  mainBranchId     String? @map("main_branch_id") @db.Uuid
  manifestBranchId String? @map("manifest_branch_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone           Zone?           @relation(fields: [clientId, zoneId], references: [clientId, id], onDelete: Restrict)
  serviceCentres ServiceCentre[]
  mainBranch     Destination?    @relation("DestinationMainBranch", fields: [clientId, mainBranchId], references: [clientId, id], onDelete: Restrict)
  servesAsMain   Destination[]   @relation("DestinationMainBranch")
  manifestBranch Destination?    @relation("DestinationManifestBranch", fields: [clientId, manifestBranchId], references: [clientId, id], onDelete: Restrict)
  servesManifest Destination[]   @relation("DestinationManifestBranch")

  @@unique([clientId, id], name: "destination_client_id")
  /// The list is filtered and sorted on these in the database, so they are
  /// indexed rather than left to a sequential scan over a few thousand rows.
  @@index([clientId, code])
  @@index([clientId, name])
  @@index([clientId, kind, isActive])
  @@index([clientId, stateCode])
  @@map("destinations")
}

/// @scope(client)
/// A service centre — the legal entity that invoices, as opposed to a
/// destination, which is a place shipments go.
///
/// One client runs several: "EXCELEX EXPRESS LOGISTICS LLP" and "EXCELEX
/// LOGISTICS SERVICES" are separate centres billing from the same branch. That
/// is why the invoice numbering, GST registration and bank account live here
/// rather than on the client — they differ per centre, and an invoice has to
/// carry the details of the entity that issued it.
model ServiceCentre {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  code    String
  name    String
  subName String? @map("sub_name")

  // ── Registered address ───────────────────────────────────────────────────
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  addressLine3 String? @map("address_line3")
  addressLine4 String? @map("address_line4")
  pinCode      String? @map("pin_code")
  countryCode  String  @default("IN") @map("country_code")
  stateCode    String? @map("state_code")

  /// The place this centre operates from. The list calls it "Branch".
  destinationId String? @map("destination_id") @db.Uuid

  telephone String?
  email     String?

  // ── Statutory registrations ──────────────────────────────────────────────
  /// Per centre, not per client: each registered entity has its own.
  gstin        String?
  gstTelephone String? @map("gst_telephone")
  pan          String?
  /// Importer/exporter code number, and the legacy service-tax number.
  icnNo        String? @map("icn_no")
  stNo         String? @map("st_no")

  // ── Invoice artwork ──────────────────────────────────────────────────────
  /// Object-storage keys. Nothing writes these yet — uploads need the storage
  /// service, which is not wired. The columns exist so the screen can say so.
  companyLogoKey   String? @map("company_logo_key")
  signatoryLogoKey String? @map("signatory_logo_key")

  /// The ten free-text lines printed on an invoice, in order.
  ///
  /// An array rather than ten columns because they are positional lines of
  /// print, not ten distinct facts. Note the legacy data puts bank details in
  /// lines 7 to 10 — those have proper fields below, and the terms should carry
  /// terms.
  terms String[] @default([])

  // ── Bank details ─────────────────────────────────────────────────────────
  bankName        String? @map("bank_name")
  bankAccountNo   String? @map("bank_account_no")
  bankAccountName String? @map("bank_account_name")
  bankAddress     String? @map("bank_address")
  ifsc            String?
  micr            String?

  // ── Document numbering ───────────────────────────────────────────────────
  /// The last number ISSUED, not the next one. Allocation must therefore read,
  /// increment and write under a row lock — two concurrent invoices reading the
  /// same value would both claim it, and duplicate invoice numbers are a
  /// statutory problem rather than a cosmetic one. The allocation service
  /// arrives with invoicing; these columns are the state it will guard.
  invoicePrefix    String? @map("invoice_prefix")
  invoiceLastNo    Int     @default(0) @map("invoice_last_no")
  invoiceSuffix    String? @map("invoice_suffix")
  freeFormPrefix   String? @map("free_form_prefix")
  freeFormLastNo   Int     @default(0) @map("free_form_last_no")
  freeFormSuffix   String? @map("free_form_suffix")
  debitNotePrefix  String? @map("debit_note_prefix")
  debitNoteLastNo  Int     @default(0) @map("debit_note_last_no")
  debitNoteSuffix  String? @map("debit_note_suffix")
  creditNotePrefix String? @map("credit_note_prefix")
  creditNoteLastNo Int     @default(0) @map("credit_note_last_no")
  creditNoteSuffix String? @map("credit_note_suffix")
  receiptLastNo    Int     @default(0) @map("receipt_last_no")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  destination Destination? @relation(fields: [clientId, destinationId], references: [clientId, id], onDelete: Restrict)

  @@index([clientId, code])
  @@index([clientId, name])
  @@index([clientId])
  @@map("service_centres")
}

/// @scope(client)
/// A sales executive — the person who owns a customer relationship and, later,
/// earns commission on what that customer ships.
model SalesExecutive {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  code String
  name String

  /// Commission percentage, exact.
  ///
  /// Decimal, not a float: this multiplies invoice amounts, and binary floating
  /// point cannot represent 2.5% exactly. Four decimal places because brokerage
  /// splits are quoted in basis points, and the ceiling of 100 is enforced in
  /// the migration — a commission above the sale is a data-entry error, not a
  /// business model.
  commissionPercent Decimal @default(0) @map("commission_percent") @db.Decimal(7, 4)

  email  String?
  mobile String?

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([clientId, code])
  @@index([clientId, name])
  @@index([clientId])
  @@map("sales_executives")
}
