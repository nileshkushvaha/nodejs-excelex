{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^db:generate",
        "db:generate",
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^db:generate",
        "db:generate",
        "^build"
      ]
    },
    "lint": {},
    "format:check": {},
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:security": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "check:rls-coverage": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
